# Publish only the maintained, portable project below. Historical local files stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/.github/
!/requirements.txt
!/environment.yml
!/scripts/
!/configs/
!/workflows/
!/docs/
!/env/
!/tests/

# Credentials, machine-specific configuration and private metadata.
**/.env
**/.env.*
**/*.local.*
/configs/local.toml
**/secrets.json
**/credentials.json
**/*credentials*.json
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*

# Models and training artifacts are intentionally not managed with Git LFS.
**/*.safetensors
**/*.ckpt
**/*.pt
**/*.pth
**/*.bin
**/*.onnx
**/*.gguf
**/*.npy
**/*.npz
**/*.pkl
**/*.pickle
**/*.db
**/*.sqlite*
**/*.log
**/events.out.tfevents.*
**/cache/
**/workspace/
**/runs/
**/outputs/
**/training_runs/

# Original references, training images, generated images and archives.
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.bmp
**/*.tif
**/*.tiff
**/*.mp4
**/*.mp3
**/*.wav
**/*.zip
**/*.7z
**/*.tar
**/*.gz
**/*.html

# Environments and editor caches.
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
**/.DS_Store
**/Thumbs.db
